{
  "key": "ChangeLifecycle",
  "version": "v1",
  "display_name": "Change Lifecycle",
  "description": "Canonical lifecycle event for changing an existing projection state.",
  "schema": {
    "type": "object",
    "properties": {
      "change_id": {"type": "string"},
      "source_project": {"type": "string"},
      "target_ref": {"type": "string", "default": "refs/heads/main"},
      "provider_delivery_id": {"type": "string"},
      "lifecycle_event": {"type": "string"},
      "lifecycle_reason": {"type": "string"},
      "issue_iid": {"type": "integer"},
      "issue_url": {"type": "string"}
    }
  },
  "required_fields": ["change_id", "source_project", "target_ref", "provider_delivery_id", "lifecycle_event", "lifecycle_reason"],
  "semantic_roles": {
    "change_id": "change_identity",
    "source_project": "source_project_identity",
    "target_ref": "target_ref",
    "provider_delivery_id": "delivery_identity",
    "lifecycle_event": "lifecycle_event",
    "lifecycle_reason": "lifecycle_reason"
  },
  "allow_extensions": true,
  "status": "published"
}
